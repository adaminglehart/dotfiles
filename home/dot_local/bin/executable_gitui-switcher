#!/usr/bin/env bash
set -euo pipefail

script_path="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"

require_commands() {
    local command_name

    for command_name in "$@"; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            printf 'gitui-switcher: required command not found: %s\n' "$command_name" >&2
            exit 1
        fi
    done
}

show_placeholder() {
    clear
    printf '\n  Select a repository from the left.\n'
    printf '\n  Ctrl-a + left/right: move focus\n'
    printf '  Ctrl-a + q: quit\n'

    while true; do
        sleep 3600
    done
}

discover_repositories() {
    if [[ ! -d "$HOME/dev" ]]; then
        return
    fi

    fd --hidden --type d --glob .git --max-depth 3 "$HOME/dev" 2>/dev/null |
        sed 's#/.git/$##' |
        sort
}

run_picker() {
    local viewer_pane="$1"
    local repo

    require_commands fd fzf git tmux

    if [[ -z "${TMUX:-}" ]]; then
        printf 'gitui-switcher: picker mode must run inside tmux\n' >&2
        exit 1
    fi

    while tmux display-message -p -t "$viewer_pane" '#{pane_id}' >/dev/null 2>&1; do
        if ! repo="$(
            discover_repositories |
                fzf \
                    --border=none \
                    --height=100% \
                    --layout=reverse \
                    --no-multi \
                    --prompt='Repository> ' \
                    --header='Enter: open  Esc: GitUI  Ctrl-a q: quit'
        )"; then
            tmux select-pane -t "$viewer_pane" 2>/dev/null || exit 0
            continue
        fi

        if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            tmux display-message -d 2000 "Not a Git repository: $repo"
            continue
        fi

        tmux respawn-pane -k -c "$repo" -t "$viewer_pane" gitui
        tmux select-pane -T GitUI -t "$viewer_pane"
        tmux select-pane -t "$viewer_pane"
    done
}

launch() {
    local socket_name="gitui-switcher-$$-$RANDOM"
    local session_name="gitui-switcher"
    local tmux_conf="$HOME/.config/tmux/tmux.conf"
    local initial_repo=""
    local viewer_cwd="$PWD"
    local viewer_command
    local viewer_pane
    local picker_command
    local picker_pane
    local socket_path=""

    require_commands fd fzf git gitui tmux

    if [[ ! -f "$tmux_conf" ]]; then
        tmux_conf=/dev/null
    fi

    tmux_cmd() {
        tmux -L "$socket_name" -f "$tmux_conf" "$@"
    }

    cleanup() {
        tmux_cmd kill-server >/dev/null 2>&1 || true
        if [[ -n "$socket_path" ]]; then
            rm -f -- "$socket_path"
        fi
    }

    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM

    initial_repo="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$initial_repo" ]]; then
        viewer_cwd="$initial_repo"
        viewer_command=gitui
    else
        printf -v viewer_command 'exec bash %q --placeholder' "$script_path"
    fi

    viewer_pane="$(
        tmux_cmd new-session \
            -d \
            -P \
            -F '#{pane_id}' \
            -s "$session_name" \
            -n GitUI \
            -c "$viewer_cwd" \
            "$viewer_command"
    )"
    socket_path="$(tmux_cmd display-message -p '#{socket_path}')"

    tmux_cmd set-option -g status off
    tmux_cmd set-option -g mouse on
    tmux_cmd set-option -g prefix C-a
    tmux_cmd set-option -g pane-border-status top
    tmux_cmd set-option -g pane-border-format ' #{pane_title} '
    tmux_cmd set-option -g automatic-rename off
    tmux_cmd set-option -p -t "$viewer_pane" remain-on-exit on
    tmux_cmd unbind-key C-b
    tmux_cmd bind-key C-a send-prefix
    tmux_cmd bind-key -r Left select-pane -L
    tmux_cmd bind-key -r Right select-pane -R
    tmux_cmd bind-key -r h select-pane -L
    tmux_cmd bind-key -r l select-pane -R
    tmux_cmd bind-key q kill-session
    tmux_cmd select-pane -T GitUI -t "$viewer_pane"

    printf -v picker_command 'exec bash %q --picker %q' "$script_path" "$viewer_pane"
    picker_pane="$(
        tmux_cmd split-window \
            -h \
            -b \
            -l '20%' \
            -P \
            -F '#{pane_id}' \
            -t "$viewer_pane" \
            "$picker_command"
    )"

    tmux_cmd select-pane -T Repositories -t "$picker_pane"
    tmux_cmd select-pane -t "$picker_pane"

    TMUX='' tmux -L "$socket_name" -f "$tmux_conf" attach-session -t "$session_name" || true
    cleanup
    trap - EXIT
}

case "${1:-}" in
    --picker)
        if [[ $# -ne 2 ]]; then
            printf 'usage: gitui-switcher --picker <viewer-pane-id>\n' >&2
            exit 2
        fi
        run_picker "$2"
        ;;
    --placeholder)
        if [[ $# -ne 1 ]]; then
            printf 'usage: gitui-switcher --placeholder\n' >&2
            exit 2
        fi
        show_placeholder
        ;;
    "")
        launch
        ;;
    *)
        printf 'usage: gitui-switcher\n' >&2
        exit 2
        ;;
esac
